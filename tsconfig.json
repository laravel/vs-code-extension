{
    "compilerOptions": {
        "module": "node16",
        "target": "es2022",
        "lib": ["ES2022"],
        "types": ["node", "vscode", "mocha"],
        "sourceMap": true,
        "rootDir": "src",
        "outDir": "out",
        "baseUrl": ".",
        "paths": {
            "@src/*": ["src/*"]
        },

        /* Linting */
        "strict": true
    },
    "exclude": ["server", "src/test/fixtures"]
}
